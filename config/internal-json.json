{
  "schema_version": "1.2",
  "schemas": {
    "AnswerPayload": {
      "$id": "internal://schemas/AnswerPayload",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "answer": {
          "type": "string"
        },
        "final_context": {
          "additionalProperties": false,
          "properties": {
            "conversation_context": {
              "minLength": 1,
              "type": "string"
            },
            "intent": {
              "minLength": 1,
              "type": "string"
            },
            "steps_executed": {
              "items": {
                "$ref": "internal://schemas/StepExecution"
              },
              "type": "array"
            }
          },
          "required": [
            "intent",
            "steps_executed"
          ],
          "type": "object"
        },
        "timings_ms": {
          "additionalProperties": {
            "minimum": 0,
            "type": "integer"
          },
          "default": {},
          "type": "object"
        }
      },
      "required": [
        "answer",
        "final_context"
      ],
      "type": "object"
    },
    "ContextPolicy": {
      "$id": "internal://schemas/ContextPolicy",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "standalone",
            "recent"
          ],
          "type": "string"
        },
        "recent_turns": {
          "maximum": 50,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "mode"
      ],
      "type": "object"
    },
    "Envelope": {
      "$id": "internal://schemas/Envelope",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "metadata": {
          "$ref": "internal://schemas/Metadata"
        },
        "payload": {
          "oneOf": [
            {
              "$ref": "internal://schemas/UserRequestPayload"
            },
            {
              "$ref": "internal://schemas/PlannerOutput"
            },
            {
              "$ref": "internal://schemas/ValidatorOutput"
            },
            {
              "$ref": "internal://schemas/ExecutorResult"
            },
            {
              "$ref": "internal://schemas/FinalLLMInput"
            },
            {
              "$ref": "internal://schemas/AnswerPayload"
            },
            {
              "$ref": "internal://schemas/ErrorPayload"
            },
            {
              "$ref": "internal://schemas/PlannerInput"
            },
            {
              "$ref": "internal://schemas/ValidatorInput"
            },
            {
              "$ref": "internal://schemas/ExecutorInput"
            },
            {
              "$ref": "internal://schemas/ContextPolicyOutput"
            }
          ]
        }
      },
      "required": [
        "metadata",
        "payload"
      ],
      "type": "object"
    },
    "ErrorPayload": {
      "$id": "internal://schemas/ErrorPayload",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "debug": {
          "additionalProperties": true,
          "type": [
            "object",
            "null"
          ]
        },
        "error": {
          "additionalProperties": false,
          "properties": {
            "code": {
              "minLength": 1,
              "type": "string"
            },
            "detail": {
              "type": [
                "object",
                "null"
              ]
            },
            "message": {
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "code",
            "message"
          ],
          "type": "object"
        }
      },
      "required": [
        "error"
      ],
      "type": "object"
    },
    "ExecutorInput": {
      "$id": "internal://schemas/ExecutorInput",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "planner_output": {
          "$ref": "internal://schemas/PlannerOutput"
        },
        "request_context": {
          "additionalProperties": false,
          "properties": {
            "request_id": {
              "minLength": 1,
              "type": "string"
            },
            "user_message": {
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "request_id",
            "user_message"
          ],
          "type": "object"
        }
      },
      "required": [
        "planner_output",
        "request_context"
      ],
      "type": "object"
    },
    "ExecutorResult": {
      "$id": "internal://schemas/ExecutorResult",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "intent": {
          "minLength": 1,
          "type": "string"
        },
        "steps_executed": {
          "items": {
            "$ref": "internal://schemas/StepExecution"
          },
          "type": "array"
        }
      },
      "required": [
        "intent",
        "steps_executed"
      ],
      "type": "object"
    },
    "FinalLLMInput": {
      "$id": "internal://schemas/FinalLLMInput",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "final_context": {
          "additionalProperties": false,
          "properties": {
            "conversation_context": {
              "minLength": 1,
              "type": "string"
            },
            "intent": {
              "minLength": 1,
              "type": "string"
            },
            "steps_executed": {
              "items": {
                "$ref": "internal://schemas/StepExecution"
              },
              "type": "array"
            }
          },
          "required": [
            "intent",
            "steps_executed"
          ],
          "type": "object"
        },
        "final_output_spec": {
          "$ref": "internal://schemas/FinalOutputSpec"
        }
      },
      "required": [
        "final_context",
        "final_output_spec"
      ],
      "type": "object"
    },
    "FinalOutputSpec": {
      "$id": "internal://schemas/FinalOutputSpec",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "constraints": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "format": {
          "enum": [
            "text",
            "markdown",
            "json"
          ],
          "type": "string"
        },
        "tone": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "format",
        "tone",
        "constraints"
      ],
      "type": "object"
    },
    "Metadata": {
      "$id": "internal://schemas/Metadata",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "message_type": {
          "type": "string"
        },
        "request_id": {
          "minLength": 1,
          "type": "string"
        },
        "schema_version": {
          "pattern": "^\\d+\\.\\d+$",
          "type": "string"
        },
        "session_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "minLength": 1,
          "type": "string"
        },
        "timestamp": {
          "minLength": 1,
          "type": "string"
        },
        "timings_ms": {
          "additionalProperties": {
            "minimum": 0,
            "type": "integer"
          },
          "default": {},
          "type": "object"
        },
        "trace": {
          "additionalProperties": false,
          "properties": {
            "span_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "trace_id": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "trace_id",
            "span_id"
          ],
          "type": "object"
        },
        "user_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "schema_version",
        "message_type",
        "request_id",
        "timestamp",
        "source"
      ],
      "type": "object"
    },
    "Plan": {
      "$id": "internal://schemas/Plan",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "steps": {
          "items": {
            "$ref": "internal://schemas/Step"
          },
          "minItems": 1,
          "type": "array"
        },
        "strategy": {
          "enum": [
            "sequential",
            "parallel",
            "hybrid"
          ],
          "type": "string"
        }
      },
      "required": [
        "strategy",
        "steps"
      ],
      "type": "object"
    },
    "PlannerInput": {
      "$id": "internal://schemas/PlannerInput",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "constraints": {
          "additionalProperties": false,
          "properties": {
            "budget": {
              "additionalProperties": false,
              "properties": {
                "max_completion_tokens": {
                  "minimum": 64,
                  "type": "integer"
                },
                "max_prompt_tokens": {
                  "minimum": 256,
                  "type": "integer"
                }
              },
              "type": "object"
            },
            "max_dependency_depth": {
              "maximum": 50,
              "minimum": 1,
              "type": "integer"
            },
            "max_steps": {
              "maximum": 200,
              "minimum": 1,
              "type": "integer"
            },
            "max_tool_calls": {
              "maximum": 100,
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "max_steps",
            "max_tool_calls",
            "max_dependency_depth"
          ],
          "type": "object"
        },
        "context": {
          "additionalProperties": false,
          "properties": {
            "memory_facts": {
              "default": [],
              "items": {
                "additionalProperties": false,
                "properties": {
                  "confidence": {
                    "maximum": 1,
                    "minimum": 0,
                    "type": "number"
                  },
                  "key": {
                    "maxLength": 128,
                    "minLength": 1,
                    "type": "string"
                  },
                  "source": {
                    "maxLength": 256,
                    "type": "string"
                  },
                  "value": {
                    "maxLength": 2000,
                    "minLength": 1,
                    "type": "string"
                  }
                },
                "required": [
                  "key",
                  "value",
                  "confidence"
                ],
                "type": "object"
              },
              "maxItems": 80,
              "type": "array"
            },
            "recent_user_messages": {
              "default": [],
              "items": {
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "maxLength": 64,
                    "minLength": 1,
                    "type": "string"
                  },
                  "request_id": {
                    "minLength": 8,
                    "type": "string"
                  },
                  "text": {
                    "maxLength": 16000,
                    "minLength": 1,
                    "type": "string"
                  }
                },
                "required": [
                  "id",
                  "text"
                ],
                "type": "object"
              },
              "maxItems": 12,
              "type": "array"
            },
            "session_state": {
              "additionalProperties": false,
              "properties": {
                "last_intent_type": {
                  "enum": [
                    "informational",
                    "action",
                    "creative",
                    "other"
                  ],
                  "type": "string"
                },
                "last_tool_calls": {
                  "items": {
                    "additionalProperties": false,
                    "properties": {
                      "capability": {
                        "maxLength": 128,
                        "minLength": 1,
                        "type": "string"
                      },
                      "status": {
                        "enum": [
                          "success",
                          "error",
                          "skipped"
                        ],
                        "type": "string"
                      }
                    },
                    "required": [
                      "capability",
                      "status"
                    ],
                    "type": "object"
                  },
                  "maxItems": 20,
                  "type": "array"
                }
              },
              "type": "object"
            }
          },
          "required": [
            "recent_user_messages"
          ],
          "type": "object"
        },
        "replan_feedback": {
          "additionalProperties": false,
          "properties": {
            "attempt": {
              "maximum": 50,
              "minimum": 1,
              "type": "integer"
            },
            "errors": {
              "default": [],
              "items": {
                "maxLength": 2000,
                "type": "string"
              },
              "maxItems": 50,
              "type": "array"
            },
            "instruction": {
              "maxLength": 4000,
              "minLength": 1,
              "type": "string"
            },
            "stage": {
              "enum": [
                "validator",
                "executor",
                "planner"
              ],
              "type": "string"
            },
            "warnings": {
              "default": [],
              "items": {
                "maxLength": 2000,
                "type": "string"
              },
              "maxItems": 50,
              "type": "array"
            }
          },
          "required": [
            "attempt",
            "stage",
            "instruction"
          ],
          "type": "object"
        },
        "request": {
          "additionalProperties": false,
          "properties": {
            "current_user_message": {
              "maxLength": 16000,
              "minLength": 1,
              "type": "string"
            },
            "locale": {
              "maxLength": 16,
              "minLength": 2,
              "type": "string"
            },
            "request_id": {
              "minLength": 8,
              "type": "string"
            },
            "session_id": {
              "minLength": 8,
              "type": "string"
            },
            "timestamp": {
              "format": "date-time",
              "type": "string"
            }
          },
          "required": [
            "request_id",
            "session_id",
            "timestamp",
            "locale",
            "current_user_message"
          ],
          "type": "object"
        },
        "schema_version": {
          "pattern": "^\\d+\\.\\d+$",
          "type": "string"
        },
        "tools": {
          "additionalProperties": false,
          "properties": {
            "catalog": {
              "items": {
                "additionalProperties": true,
                "type": "object"
              },
              "maxItems": 200,
              "type": "array"
            },
            "policy": {
              "$ref": "internal://schemas/ToolPolicy"
            }
          },
          "required": [
            "catalog",
            "policy"
          ],
          "type": "object"
        }
      },
      "required": [
        "schema_version",
        "request",
        "context",
        "tools",
        "constraints"
      ],
      "type": "object"
    },
    "PlannerOutput": {
      "$id": "internal://schemas/PlannerOutput",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "plan": {
          "$ref": "internal://schemas/Plan"
        },
        "user_intent": {
          "$ref": "internal://schemas/UserIntent"
        },
        "violations": {
          "default": [],
          "items": {
            "additionalProperties": false,
            "properties": {
              "code": {
                "minLength": 1,
                "type": "string"
              },
              "detail": {
                "type": [
                  "object",
                  "null"
                ]
              },
              "message": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "code",
              "message"
            ],
            "type": "object"
          },
          "type": "array"
        }
      },
      "required": [
        "user_intent",
        "plan"
      ],
      "type": "object"
    },
    "Step": {
      "$id": "internal://schemas/Step",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "tool_call"
              }
            }
          },
          "then": {
            "properties": {
              "capability": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "capability"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "compose"
              }
            }
          },
          "then": {
            "properties": {
              "capability": {
                "type": "null"
              }
            }
          }
        }
      ],
      "properties": {
        "agent": {
          "type": [
            "string",
            "null"
          ]
        },
        "capability": {
          "type": [
            "string",
            "null"
          ]
        },
        "dependencies": {
          "items": {
            "pattern": "^[a-zA-Z0-9_\\-]+$",
            "type": "string"
          },
          "type": "array"
        },
        "description": {
          "minLength": 1,
          "type": "string"
        },
        "expected_output": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "type": "string"
        },
        "inputs": {
          "type": "object"
        },
        "optional": {
          "type": "boolean"
        },
        "type": {
          "enum": [
            "tool_call",
            "rag_query",
            "compute",
            "compose",
            "other"
          ],
          "type": "string"
        }
      },
      "required": [
        "id",
        "type",
        "description",
        "inputs",
        "dependencies"
      ],
      "type": "object"
    },
    "StepExecution": {
      "$id": "internal://schemas/StepExecution",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "minLength": 1,
          "type": "string"
        },
        "output": {
          "type": [
            "object",
            "null"
          ]
        },
        "status": {
          "enum": [
            "success",
            "skipped",
            "failed"
          ],
          "type": "string"
        }
      },
      "required": [
        "id",
        "status"
      ],
      "type": "object"
    },
    "ToolPolicy": {
      "$id": "internal://schemas/ToolPolicy",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "deny_tools": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        },
        "enabled_tools": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "enabled_tools"
      ],
      "type": "object"
    },
    "UserIntent": {
      "$id": "internal://schemas/UserIntent",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        "context_policy": {
          "$ref": "internal://schemas/ContextPolicy"
        },
        "locale": {
          "minLength": 2,
          "type": "string"
        },
        "summary": {
          "minLength": 1,
          "type": "string"
        },
        "type": {
          "enum": [
            "informational",
            "action",
            "creative",
            "other"
          ],
          "type": "string"
        }
      },
      "required": [
        "summary",
        "type",
        "confidence"
      ],
      "type": "object"
    },
    "UserRequestPayload": {
      "$id": "internal://schemas/UserRequestPayload",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "enabled_tools": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "message": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "message"
      ],
      "type": "object"
    },
    "ValidatorInput": {
      "$id": "internal://schemas/ValidatorInput",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "discovered_tools": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "type": "array"
        },
        "planner_output": {
          "$ref": "internal://schemas/PlannerOutput"
        },
        "tool_policy": {
          "$ref": "internal://schemas/ToolPolicy"
        }
      },
      "required": [
        "planner_output",
        "tool_policy"
      ],
      "type": "object"
    },
    "ValidatorOutput": {
      "$id": "internal://schemas/ValidatorOutput",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "plan": {
          "additionalProperties": false,
          "properties": {
            "steps_ready": {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          "required": [
            "steps_ready"
          ],
          "type": "object"
        },
        "validation": {
          "additionalProperties": false,
          "properties": {
            "errors": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "is_valid": {
              "type": "boolean"
            },
            "missing_steps": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "warnings": {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          "required": [
            "is_valid",
            "errors",
            "warnings",
            "missing_steps"
          ],
          "type": "object"
        }
      },
      "required": [
        "validation",
        "plan"
      ],
      "type": "object"
    },
    "ContextPolicyOutput": {
      "$id": "internal://schemas/ContextPolicyOutput",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "current_user_message": {
          "type": "string"
        },
        "decision": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "standalone",
                "recent"
              ]
            },
            "recent_turns": {
              "type": "integer",
              "minimum": 0,
              "maximum": 50
            },
            "confidence": {
              "type": "number",
              "minimum": 0.0,
              "maximum": 1.0
            }
          },
          "required": [
            "mode",
            "recent_turns",
            "confidence"
          ]
        },
        "error": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200
        }
      },
      "required": [
        "current_user_message",
        "decision",
        "error"
      ]
    }
  },
  "validator_rules": {
    "plan_validator": {
      "about": "Structural validation is enforced by JSON Schema. Semantic validation is enforced deterministically by PlanValidator using this catalog (validator_rules.plan_validator).",
      "error_prefix": "PV",
      "templates": {
        "001": "Plan has no steps.",
        "002": "Plan exceeds max_steps={max_steps} (got {got}).",
        "003": "Plan exceeds max_tool_calls={max_tool_calls} (got {got}).",
