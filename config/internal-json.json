{
  "schema_version": "1.1",
  "schemas": {
    "Envelope": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "internal://schemas/Envelope",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metadata",
        "payload"
      ],
      "properties": {
        "metadata": {
          "$ref": "internal://schemas/Metadata"
        },
        "payload": {
          "oneOf": [
            {
              "$ref": "internal://schemas/UserRequestPayload"
            },
            {
              "$ref": "internal://schemas/PlannerOutput"
            },
            {
              "$ref": "internal://schemas/ValidatorOutput"
            },
            {
              "$ref": "internal://schemas/ExecutorResult"
            },
            {
              "$ref": "internal://schemas/FinalLLMInput"
            },
            {
              "$ref": "internal://schemas/AnswerPayload"
            },
            {
              "$ref": "internal://schemas/ErrorPayload"
            },
            {
              "$ref": "internal://schemas/PlannerInput"
            },
            {
              "$ref": "internal://schemas/ValidatorInput"
            },
            {
              "$ref": "internal://schemas/ExecutorInput"
            }
          ]
        }
      }
    },
    "UserRequestPayload": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "internal://schemas/UserRequestPayload",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "message"
      ],
      "properties": {
        "message": {
          "type": "string",
          "minLength": 1
        },
        "enabled_tools": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      }
    },
    "ErrorPayload": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "internal://schemas/ErrorPayload",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "error"
      ],
      "properties": {
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "type": "string",
              "minLength": 1
            },
            "message": {
              "type": "string",
              "minLength": 1
            },
            "detail": {
              "type": [
                "object",
                "null"
              ]
            }
          }
        },
        "debug": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": true
        }
      }
    },
    "Metadata": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "internal://schemas/Metadata",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "message_type",
        "request_id",
        "timestamp",
        "source"
      ],
      "properties": {
        "schema_version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+$"
        },
        "message_type": {
          "type": "string"
        },
        "request_id": {
          "type": "string",
          "minLength": 1
        },
        "timestamp": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "user_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "session_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "trace": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "trace_id",
            "span_id"
          ],
          "properties": {
            "trace_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "span_id": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "timings_ms": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          },
          "default": {}
        }
      }
    },
    "ToolPolicy": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "internal://schemas/ToolPolicy",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "allowlist",
            "denylist"
          ]
        },
        "allow": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "deny": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "PlannerOutput": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "internal://schemas/PlannerOutput",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "user_intent",
        "plan"
      ],
      "properties": {
        "user_intent": {
          "$ref": "internal://schemas/UserIntent"
        },
        "plan": {
          "$ref": "internal://schemas/Plan"
        },
        "violations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1
              },
              "message": {
                "type": "string",
                "minLength": 1
              },
              "detail": {
                "type": [
                  "object",
                  "null"
                ]
              }
            }
          },
          "default": []
        }
      }
    },
    "UserIntent": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "internal://schemas/UserIntent",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary",
        "type",
        "confidence"
      ],
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "enum": [
            "informational",
            "action",
            "creative",
            "other"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "locale": {
          "type": "string",
          "minLength": 2
        }
      }
    },
    "Plan": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "internal://schemas/Plan",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strategy",
        "steps"
      ],
      "properties": {
        "strategy": {
          "type": "string",
          "enum": [
            "sequential",
            "parallel",
            "hybrid"
          ]
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "internal://schemas/Step"
          }
        }
      }
    },
    "Step": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "internal://schemas/Step",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "description",
        "inputs",
        "dependencies"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "type": {
          "type": "string",
          "enum": [
            "tool_call",
            "rag_query",
            "compute",
            "compose",
            "other"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "capability": {
          "type": [
            "string",
            "null"
          ]
        },
        "agent": {
          "type": [
            "string",
            "null"
          ]
        },
        "inputs": {
          "type": "object"
        },
        "expected_output": {
          "type": [
            "string",
            "null"
          ]
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_\\-]+$"
          }
        },
        "optional": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "tool_call"
              }
            }
          },
          "then": {
            "required": [
              "capability"
            ],
            "properties": {
              "capability": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "compose"
              }
            }
          },
          "then": {
            "properties": {
              "capability": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "ValidatorOutput": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "internal://schemas/ValidatorOutput",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "validation",
        "plan"
      ],
      "properties": {
        "validation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "is_valid",
            "errors",
            "warnings",
            "missing_steps"
          ],
          "properties": {
            "is_valid": {
              "type": "boolean"
            },
            "errors": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "warnings": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "missing_steps": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "plan": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "steps_ready"
          ],
          "properties": {
            "steps_ready": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "StepExecution": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "internal://schemas/StepExecution",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "success",
            "skipped",
            "failed"
          ]
        },
        "output": {
          "type": [
            "object",
            "null"
          ]
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "ExecutorResult": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "internal://schemas/ExecutorResult",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "intent",
        "steps_executed"
      ],
      "properties": {
        "intent": {
          "type": "string",
          "minLength": 1
        },
        "steps_executed": {
          "type": "array",
          "items": {
            "$ref": "internal://schemas/StepExecution"
          }
        }
      }
    },
    "FinalOutputSpec": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "internal://schemas/FinalOutputSpec",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "tone",
        "constraints"
      ],
      "properties": {
        "format": {
          "type": "string",
          "enum": [
            "text",
            "markdown",
            "json"
          ]
        },
        "tone": {
          "type": "string",
          "minLength": 1
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "FinalLLMInput": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "internal://schemas/FinalLLMInput",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "final_context",
        "final_output_spec"
      ],
      "properties": {
        "final_context": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "intent",
            "steps_executed"
          ],
          "properties": {
            "intent": {
              "type": "string",
              "minLength": 1
            },
            "steps_executed": {
              "type": "array",
              "items": {
                "$ref": "internal://schemas/StepExecution"
              }
            }
          }
        },
        "final_output_spec": {
          "$ref": "internal://schemas/FinalOutputSpec"
        }
      }
    },
    "AnswerPayload": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "internal://schemas/AnswerPayload",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "answer",
        "final_context"
      ],
      "properties": {
        "answer": {
          "type": "string"
        },
        "final_context": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "intent",
            "steps_executed"
          ],
          "properties": {
            "intent": {
              "type": "string",
              "minLength": 1
            },
            "steps_executed": {
              "type": "array",
              "items": {
                "$ref": "internal://schemas/StepExecution"
              }
            }
          }
        },
        "timings_ms": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          },
          "default": {}
        }
      }
    },
    "PlannerInput": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "internal://schemas/PlannerInput",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "user_message",
        "allowed_tools"
      ],
      "properties": {
        "user_message": {
          "type": "string",
          "minLength": 1
        },
        "allowed_tools": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "enabled_tools": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "locale": {
          "type": "string",
          "minLength": 2
        },
        "replan_feedback": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "ValidatorInput": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "internal://schemas/ValidatorInput",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "planner_output",
        "tool_policy"
      ],
      "properties": {
        "planner_output": {
          "$ref": "internal://schemas/PlannerOutput"
        },
        "tool_policy": {
          "$ref": "internal://schemas/ToolPolicy"
        },
        "discovered_tools": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    },
    "ExecutorInput": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "internal://schemas/ExecutorInput",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "planner_output",
        "request_context"
      ],
      "properties": {
        "planner_output": {
          "$ref": "internal://schemas/PlannerOutput"
        },
        "request_context": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "request_id",
            "user_message"
          ],
          "properties": {
            "request_id": {
              "type": "string",
              "minLength": 1
            },
            "user_message": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}